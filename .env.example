# Arrmy settings. In Portainer: Add stack → Environment variables → "Load variables from .env file".
# With plain Docker Compose: save as .env next to docker-compose.yml.

# Secrets: a different random value each. Generate all five (Linux, macOS or Git Bash):
#   for k in RADARR_API_KEY SONARR_API_KEY PROWLARR_API_KEY QBIT_PASSWORD SESSION_SECRET; do echo "$k=$(openssl rand -hex 16)"; done
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
QBIT_PASSWORD=
SESSION_SECRET=

# Your user and group on the box (run `id`), your timezone, where media lives, and where app settings live.
PUID=1000
PGID=1000
TZ=Etc/UTC
DATA_DIR=/data
CONFIG_DIR=/opt/arrmy

# From https://plex.tv/claim. Expires 4 minutes after you copy it, so set it right before the first deploy.
PLEX_CLAIM=

# VPN for qBittorrent. Values for your provider: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=

# Cloudflare Zero Trust → Networks → Tunnels → create tunnel → copy the token. Point its public hostname at http://arrmy:3000.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: Discord channel → Edit Channel → Integrations → Webhooks → Copy Webhook URL.
DISCORD_WEBHOOK_URL=
