# Arrmy settings. In Portainer: Add stack → Environment variables → "Load variables from .env file".
# With plain Docker Compose: save as .env next to docker-compose.yml.

# Secrets: a different random value each. Generate all five (Linux, macOS or Git Bash):
#   for k in RADARR_API_KEY SONARR_API_KEY PROWLARR_API_KEY QBIT_PASSWORD SESSION_SECRET; do echo "$k=$(openssl rand -hex 16)"; done
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=
QBIT_PASSWORD=
SESSION_SECRET=

# Your user and group on the box (run `id`), your timezone, where media lives, and where app settings live
# (each app gets its own folder inside CONFIG_DIR, e.g. /opt/arrmy/radarr).
PUID=1000
PGID=1000
TZ=Etc/UTC
DATA_DIR=/data
CONFIG_DIR=/opt/arrmy

# Nightly backups of CONFIG_DIR, and how many days of them to keep.
BACKUP_DIR=/opt/arrmy-backups
BACKUP_KEEP_DAYS=7

# Ports on the box. Change any that are already taken (Portainer → Containers lists ports in use).
# Inside Docker the apps keep their usual ports, so the tunnel still points at http://arrmy:3000.
ARRMY_PORT=7654
QBIT_PORT=7655
PLEX_PORT=32400
PROWLARR_PORT=7656
RADARR_PORT=7657
SONARR_PORT=7658
ABS_PORT=13378
LL_PORT=7659
TAUTULLI_PORT=7660
AUTOBRR_PORT=7661
TDARR_PORT=7662

# From https://plex.tv/claim. Expires 4 minutes after you copy it, so set it right before the first deploy.
PLEX_CLAIM=

# VPN for qBittorrent, set up for Private Internet Access (other providers: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers).
# Your PIA login (username looks like p1234567). SERVER_REGIONS is optional: the nearest region, e.g. Netherlands, UK London, DE Frankfurt.
# If the VPN fails to start, the gluetun log lists every valid region name.
VPN_SERVICE_PROVIDER=private internet access
VPN_TYPE=openvpn
OPENVPN_USER=
OPENVPN_PASSWORD=
SERVER_REGIONS=
PORT_FORWARD_ONLY=true
VPN_PORT_FORWARDING=on

# Cloudflare Zero Trust → Networks → Tunnels → create tunnel → copy the token. Point its public hostname at http://arrmy:3000.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: the Discord bot (README → Discord). It makes an Arrmy category with 7 channels and posts everything there.
# discord.com/developers/applications → New Application. Bot → Reset Token = DISCORD_BOT_TOKEN.
# General Information → Public Key = DISCORD_PUBLIC_KEY. Right-click your server → Copy Server ID = DISCORD_GUILD_ID.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
# Your Discord user id, so the bot @mentions you when something needs you. Discord → Settings → Advanced → Developer
# Mode on, then right-click your name → Copy User ID.
DISCORD_ADMIN_ID=
# Where the apps are public (arrmy., radarr., sonarr., prowlarr., qbit., plex., books.<domain>), for links in messages.
PUBLIC_DOMAIN=
# Optional: the arrmy stack's page in Portainer, linked from update messages.
PORTAINER_STACK_URL=
# Optional, without the bot: one channel's webhook (Edit Channel → Integrations → Webhooks) gets Requests and Problems.
DISCORD_WEBHOOK_URL=

# Optional: Audiobookshelf → Settings → API Keys → Add API Key (an admin key). With it, Arrmy shows which audiobooks
# you already own and deletes removed audiobook Requests from Audiobookshelf; without it, those files stay.
ABS_API_KEY=

# Optional: a Hardcover API key (hardcover.app → Settings → Hardcover API → New API Key, read-only scope is enough).
# Audiobook search by Series then uses Hardcover's series lists: OpenLibrary leaves many books untagged (The Lord of
# the Rings, for one). Without it, Series search uses OpenLibrary's own series field.
HARDCOVER_TOKEN=

# Optional: The Doctarr. Claude looks into each new Problem on your Claude subscription, runs a safe fix if it finds one,
# and posts what it found to #problems. On any PC with Claude Code: run `claude setup-token`, sign in, paste the token here.
# DOCTOR_DAILY caps how many Problems it looks into a day, so your subscription's limits stay yours.
# When AudioBook Bay refuses the VPN's region, it moves the VPN to one that works and searches the Edition again.
# Reply in a Problem's thread when it couldn't fix it, in plain words ("download number 4"), and it carries on;
# DOCTOR_REPLIES caps those answers a day. Needs DISCORD_ADMIN_ID and the bot's Message Content Intent (README).
CLAUDE_CODE_OAUTH_TOKEN=
DOCTOR_DAILY=10
DOCTOR_REPLIES=30

# Optional: a free TMDB key (themoviedb.org → Settings → API; the v3 key or the v4 read token). Turns on Discover
# and searching movies and shows by actor, director or studio. Kometa needs it too, and only takes the v3 key.
TMDB_API_KEY=
